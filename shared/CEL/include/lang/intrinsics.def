// CEL v1's CORE intrinsic surface -- the generic, app-agnostic subset
// every host gets regardless of domain. Consumed by sema (signature/type
// checking) and by IR-gen/JIT registration (host ABI dispatch + LLVM
// function attributes). See docs/SCRIPTING_ABI.md.
//
// This file is deliberately CORE-ONLY -- no World/Entity/Transform/
// per-app entries. A host with its own domain (e.g. Creation Engine's
// World access, a future Creation Station audio domain) supplies its own
// combined intrinsics.def -- containing this same Core list plus its own
// additional CEL_INTRINSIC entries -- and arranges (via
// `target_include_directories(... BEFORE ...)` on the shared CEL
// targets) for that file to be found first on the include path, so every
// consumer of `#include "lang/intrinsics.def"` (sema, module_builder,
// intrinsic_trampolines) sees the combined list transparently, with zero
// code changes here. This is the "apps add their own function calls to
// the core at compile time" mechanism the shared library is designed
// around -- see apps/CreationEngine/Language/include/lang/intrinsics.def
// for Engine's own combined copy.
//
// Deliberately NOT include-guarded: designed to be included multiple
// times, once per consumer, each defining CEL_INTRINSIC0..3 (arity 0
// through 3 -- nothing in v1 needs more) before inclusion and #undef-ing
// them after.
//
//   CEL_INTRINSICn(name, cSymbol, purity, domain, returnType, param1Type, ..., paramNType)
//
// - name: the CEL-visible identifier.
// - cSymbol: the real extern "C" trampoline symbol
//   (src/jit/intrinsic_trampolines.cpp) registered via ORC's
//   absoluteSymbols for genuine host-ABI calls. For the 14 "pure
//   computation" math/vec3 intrinsics that GS4 already lowers directly
//   to LLVM IR (no external call at all -- see module_builder.cpp's
//   CodegenBuiltinIntrinsic), this column is inert/never dereferenced;
//   it's just set to the intrinsic's own name for a harmless,
//   documentation-consistent placeholder rather than an empty token.
// - purity: Pure (no memory access at all -- only true math, e.g.
//   atan2), ReadsWorld (may read host state but never mutate it -- gets
//   the LLVM `readonly` attribute), or Mutates (may write -- gets no
//   memory-access attribute at all). Getting this wrong for a
//   ReadsWorld/Mutates function would let the optimizer illegally
//   hoist/reorder it above a mutating call and silently corrupt observed
//   behavior -- see docs/SCRIPTING_ABI.md.
// - domain: GS-Interop's cross-app capability tag (Core or World -- see
//   lang/type.h's IntrinsicDomain). What lets a host restrict which
//   intrinsics a compiled script can actually call/link against -- see
//   docs/CROSS_APP_LANGUAGE_DOMAINS.md.
//
// Names/types are plain identifiers (Int, Float, Bool, Vec3, Entity,
// Void, String) -- each consumer's own macro expansion prefixes them
// with whatever its local Type/Purity/IntrinsicDomain scope needs.

// Math (float) -- pure IR, no real ABI call (see cSymbol note above),
// except atan2, which has no direct LLVM intrinsic and is a real
// trampoline call. Domain Core: no per-app state, available to every
// host regardless of capability profile.
CEL_INTRINSIC1(sqrt, sqrt, Pure, Core, Float, Float)
CEL_INTRINSIC1(abs, abs, Pure, Core, Float, Float)
CEL_INTRINSIC2(min, min, Pure, Core, Float, Float, Float)
CEL_INTRINSIC2(max, max, Pure, Core, Float, Float, Float)
CEL_INTRINSIC1(floor, floor, Pure, Core, Float, Float)
CEL_INTRINSIC1(sin, sin, Pure, Core, Float, Float)
CEL_INTRINSIC1(cos, cos, Pure, Core, Float, Float)
CEL_INTRINSIC2(atan2, ce_atan2, Pure, Core, Float, Float, Float)
CEL_INTRINSIC3(clamp, clamp, Pure, Core, Float, Float, Float, Float)
CEL_INTRINSIC3(lerp, lerp, Pure, Core, Float, Float, Float, Float)

// Vec3 -- pure IR, no real ABI call. Domain Core.
CEL_INTRINSIC3(vec3, vec3, Pure, Core, Vec3, Float, Float, Float)
CEL_INTRINSIC2(dot, dot, Pure, Core, Float, Vec3, Vec3)
CEL_INTRINSIC2(cross, cross, Pure, Core, Vec3, Vec3, Vec3)
CEL_INTRINSIC1(length, length, Pure, Core, Float, Vec3)
CEL_INTRINSIC1(normalize, normalize, Pure, Core, Vec3, Vec3)

// Debug -- real ABI; writes to stdout, so Mutates even though it never
// touches any host state itself (purity here is about the JIT-visible
// memory contract, not specifically "touches World"). Domain Core:
// logging is a universal capability, available regardless of an app's
// other domain access.
CEL_INTRINSIC1(log, ce_log, Mutates, Core, Void, String)
CEL_INTRINSIC2(log_int, ce_log_int, Mutates, Core, Void, String, Int)
CEL_INTRINSIC2(log_float, ce_log_float, Mutates, Core, Void, String, Float)
CEL_INTRINSIC2(log_vec3, ce_log_vec3, Mutates, Core, Void, String, Vec3)
